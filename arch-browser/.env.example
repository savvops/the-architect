ARCH_RESOLUTION=1280x800
# Required if anything other than loopback can reach archd (Tailscale Serve counts). Generate: openssl rand -hex 24
ARCH_TOKEN=
OPENROUTER_API_KEY=
# Google AI Studio API key for free-tier Gemini models (gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_API_KEY=
JEV_LOCAL_URL=http://127.0.0.1:12345
ARCH_TIER1_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
ARCH_TIER2_MODELS=deepseek/deepseek-chat
