[Unit]
Description=Arch Browser Agent Daemon connected to local Chromium
After=desktop-vnc.service

[Service]
Type=simple
Environment=DISPLAY=:101
EnvironmentFile=-%h/.config/arch-browser/.env
ExecStart=/usr/bin/python3 %h/the-architect/arch-browser/archd.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target